# Copy to .env. Never commit .env or projects.json.
#   cp .env.example .env
#   cp projects.example.json projects.json

DISCORD_BOT_TOKEN=
# Used only when a project omits discord_status_channel_id.
# DISCORD_STATUS_CHANNEL_ID=
# Optional. When omitted, alerts go to that project's status channel.
# DISCORD_ALERT_CHANNEL_ID=

# One of these. On Render, set PROJECTS_JSON. The image does not include projects.json.
# PROJECTS_JSON=[{"id":"moolah","name":"Moolah","environment":"production","checks":[]}]
PROJECTS_FILE=./projects.json

CHECK_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_MS=10000
RETRY_DELAY_MS=2000
REMINDER_MINUTES=30
TIME_ZONE=Asia/Manila

PORT=8080
# Mount a Railway volume here so message ids and uptime survive deploys.
DATA_DIR=./data
